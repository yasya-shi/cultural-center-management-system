<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="25" style="-fx-padding: 40; -fx-background-color: #fef5f5;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.culturalcenter.client.controllers.AssignDirectorController">

    <Text text="👑 Назначение директора" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>

    <Label fx:id="userLabel" textFill="#8b3a3a" style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <ComboBox fx:id="centerCombo" promptText="Выберите культурный центр" prefWidth="350" prefHeight="50"
              style="-fx-font-size: 16; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d4a0a0;"/>

    <HBox spacing="20" alignment="CENTER">
        <Button text="НАЗНАЧИТЬ" onAction="#onAssign" prefWidth="180" prefHeight="50"
                style="-fx-background-color: #a05252; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;"/>
        <Button text="ОТМЕНА" onAction="#onCancel" prefWidth="180" prefHeight="50"
                style="-fx-background-color: #d4a0a0; -fx-text-fill: #5a2a2a; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;"/>
    </HBox>

</VBox>