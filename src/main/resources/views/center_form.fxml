<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="25" style="-fx-padding: 40; -fx-background-color: #fef5f5;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.culturalcenter.client.controllers.CenterFormController">

    <Text fx:id="titleText" text="Добавление культурного центра" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>

    <GridPane hgap="15" vgap="15" alignment="CENTER">
        <Label text="Название:" textFill="#8b3a3a" style="-fx-font-size: 18; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Название центра" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="400" prefHeight="50"
                   style="-fx-font-size: 16; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>

        <Label text="Адрес:" textFill="#8b3a3a" style="-fx-font-size: 18; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="addressField" promptText="Адрес" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="50"
                   style="-fx-font-size: 16; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>

        <Label text="Телефон:" textFill="#8b3a3a" style="-fx-font-size: 18; -fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="phoneField" promptText="+375..." GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="50"
                   style="-fx-font-size: 16; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>

        <Label text="Email:" textFill="#8b3a3a" style="-fx-font-size: 18; -fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="emailField" promptText="email@example.com" GridPane.rowIndex="3" GridPane.columnIndex="1" prefHeight="50"
                   style="-fx-font-size: 16; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>
    </GridPane>

    <Separator prefWidth="600" style="-fx-background-color: #d4a0a0;"/>

    <Text text="Управление залами" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>

    <!-- Бордовая таблица залов -->
    <TableView fx:id="roomsTable" prefHeight="250" prefWidth="750"
               style="-fx-border-color: #8b3a3a; -fx-border-width: 2; -fx-border-radius: 10; -fx-selection-bar: #c97a7a; -fx-selection-bar-non-focused: #d4a0a0;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn text="Название" fx:id="colRoomName" prefWidth="200"/>
            <TableColumn text="Вместимость" fx:id="colCapacity" prefWidth="120"/>
            <TableColumn text="Оборудование" fx:id="colEquipment" prefWidth="280"/>
            <TableColumn text="Цена/час" fx:id="colPrice" prefWidth="120"/>
        </columns>
    </TableView>

    <!-- Кнопки управления залами 240x70 с текстом в 2 строки -->
    <HBox spacing="20" alignment="CENTER">
        <Button text="ДОБАВИТЬ ЗАЛ" onAction="#onAddRoom" prefWidth="240" prefHeight="70"
                wrapText="true" textAlignment="CENTER"
                style="-fx-background-color: #a05252; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>

        <Button text="РЕДАКТИРОВАТЬ ЗАЛ" onAction="#onEditRoom" prefWidth="240" prefHeight="70"
                wrapText="true" textAlignment="CENTER"
                style="-fx-background-color: #a05252; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>

        <Button text="УДАЛИТЬ ЗАЛ" onAction="#onDeleteRoom" prefWidth="240" prefHeight="70"
                wrapText="true" textAlignment="CENTER"
                style="-fx-background-color: #c97a7a; -fx-text-fill: white; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>
    </HBox>

    <!-- Кнопки сохранения/отмены -->
    <HBox spacing="30" alignment="CENTER">
        <Button text="СОХРАНИТЬ" onAction="#onSave" prefWidth="240" prefHeight="70"
                style="-fx-background-color: #8b3a3a; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>
        <Button text="ОТМЕНА" onAction="#onCancel" prefWidth="240" prefHeight="70"
                style="-fx-background-color: #d4a0a0; -fx-text-fill: #5a2a2a; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>
    </HBox>

</VBox>