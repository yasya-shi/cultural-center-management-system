<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" style="-fx-padding: 40; -fx-background-color: #fef5f5;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.culturalcenter.client.controllers.LoginController">

    <!-- Заголовок -->
    <Text text="Культурный центр" style="-fx-font-size: 48; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>
    <Text text="Система управления и бронирования" style="-fx-font-size: 24; -fx-fill: #b87a7a; -fx-font-family: 'Georgia';"/>

    <!-- Поля ввода -->
    <VBox spacing="22" maxWidth="450" style="-fx-padding: 30 0 30 0;">
        <TextField fx:id="loginField" promptText="Логин" prefHeight="60"
                   style="-fx-font-size: 21; -fx-border-radius: 12; -fx-border-color: #d4a0a0; -fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 0 15;"/>
        <PasswordField fx:id="passwordField" promptText="Пароль" prefHeight="60"
                       style="-fx-font-size: 21; -fx-border-radius: 12; -fx-border-color: #d4a0a0; -fx-background-color: #ffffff; -fx-background-radius: 12; -fx-padding: 0 15;"/>
    </VBox>

    <!-- Кнопки -->
    <Button text="ВОЙТИ" onAction="#onLogin" prefWidth="300" prefHeight="65"
            style="-fx-background-color: #a05252; -fx-text-fill: white; -fx-font-size: 21; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>

    <Button text="РЕГИСТРАЦИЯ" onAction="#onRegister" prefWidth="300" prefHeight="65"
            style="-fx-background-color: #c97a7a; -fx-text-fill: white; -fx-font-size: 21; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>

    <Button text="🚪 ВЫЙТИ" onAction="#onExit" prefWidth="200" prefHeight="45"
             style="-fx-background-color: #d4a0a0; -fx-text-fill: #5a2a2a; -fx-font-size: 16; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;"/>

</VBox>