<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 30; -fx-background-color: #fef5f5;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.culturalcenter.client.controllers.MyCenterController">

    <Text text="Мой культурный центр" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>

    <!-- Информация о центре -->
    <GridPane hgap="15" vgap="10" alignment="CENTER" style="-fx-padding: 15; -fx-border-color: #d4a0a0; -fx-border-width: 1; -fx-border-radius: 15; -fx-background-radius: 15;">
        <Label text="Название:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <Label fx:id="centerName" text="—" textFill="#5a2a2a" style="-fx-font-size: 16;" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

        <Label text="Адрес:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <Label fx:id="centerAddress" text="—" textFill="#5a2a2a" style="-fx-font-size: 16;" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

        <Label text="Телефон:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <Label fx:id="centerPhone" text="—" textFill="#5a2a2a" style="-fx-font-size: 16;" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

        <Label text="Email:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <Label fx:id="centerEmail" text="—" textFill="#5a2a2a" style="-fx-font-size: 16;" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
    </GridPane>

    <Text text="Залы центра" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>

    <!-- Таблица залов -->
    <TableView fx:id="roomsTable" prefHeight="350" VBox.vgrow="NEVER"
               style="-fx-border-color: #8b3a3a; -fx-border-width: 2; -fx-border-radius: 10; -fx-selection-bar: #c97a7a; -fx-selection-bar-non-focused: #d4a0a0;">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn text="Название" fx:id="colName" prefWidth="180"/>
            <TableColumn text="Вместимость" fx:id="colCapacity" prefWidth="100"/>
            <TableColumn text="Оборудование" fx:id="colEquipment" prefWidth="280"/>
            <TableColumn text="Цена/час" fx:id="colPrice" prefWidth="100"/>
            <TableColumn text="Статус" fx:id="colStatus" prefWidth="100"/>
        </columns>
    </TableView>

    <!-- Кнопки управления залами -->
    <HBox spacing="30" alignment="CENTER">
        <Button text="ЗАКРЫТЬ ЗАЛ" onAction="#onCloseRoom" prefWidth="220" prefHeight="70"
                style="-fx-background-color: #c97a7a; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>
        <Button text="ОТКРЫТЬ ЗАЛ" onAction="#onOpenRoom" prefWidth="220" prefHeight="70"
                style="-fx-background-color: #a05252; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>
    </HBox>

    <Button text="НАЗАД" onAction="#onBack" prefWidth="300" prefHeight="60"
            style="-fx-background-color: #d4a0a0; -fx-text-fill: #5a2a2a; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 30; -fx-cursor: hand;"/>

</VBox>