<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="TOP_CENTER" spacing="25" style="-fx-padding: 30; -fx-background-color: #fef5f5;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.culturalcenter.client.controllers.NewBookingController">

    <Text text="Новая заявка" style="-fx-font-size: 36; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>

    <GridPane hgap="20" vgap="15" alignment="CENTER" style="-fx-padding: 20; -fx-border-color: #d4a0a0; -fx-border-width: 1; -fx-border-radius: 15; -fx-background-radius: 15;">

        <Label text="Культурный центр:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <ComboBox fx:id="centerCombo" onAction="#onCenterSelected" prefWidth="300" prefHeight="40" GridPane.rowIndex="0" GridPane.columnIndex="1"
                  style="-fx-font-size: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d4a0a0;"
                  promptText="Выберите центр"/>

        <Label text="Зал:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <ComboBox fx:id="roomCombo" prefWidth="300" prefHeight="40" GridPane.rowIndex="1" GridPane.columnIndex="1"
                  style="-fx-font-size: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d4a0a0;"
                  promptText="Выберите зал"/>

        <Label text="Дата:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <DatePicker fx:id="datePicker" prefWidth="300" prefHeight="40" GridPane.rowIndex="2" GridPane.columnIndex="1"
                    style="-fx-font-size: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d4a0a0;"/>

        <Label text="Время начала:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <ComboBox fx:id="startTimeCombo" prefWidth="300" prefHeight="40" GridPane.rowIndex="3" GridPane.columnIndex="1"
                  style="-fx-font-size: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d4a0a0;"/>

        <Label text="Длительность:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
        <ComboBox fx:id="durationCombo" prefWidth="300" prefHeight="40" GridPane.rowIndex="4" GridPane.columnIndex="1"
                  style="-fx-font-size: 14; -fx-background-radius: 10; -fx-border-radius: 10; -fx-border-color: #d4a0a0;"/>

        <Label text="Цель мероприятия:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
        <TextField fx:id="purposeField" prefWidth="300" prefHeight="40" GridPane.rowIndex="5" GridPane.columnIndex="1"
                   promptText="Концерт, семинар, конференция..."
                   style="-fx-font-size: 14; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>

    </GridPane>

    <HBox spacing="30" alignment="CENTER">
        <Button text="ОТПРАВИТЬ ЗАЯВКУ" onAction="#onSubmit" prefWidth="280" prefHeight="70"
                style="-fx-background-color: #a05252; -fx-text-fill: white; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>
        <Button text="НАЗАД" onAction="#onBack" prefWidth="200" prefHeight="70"
                style="-fx-background-color: #d4a0a0; -fx-text-fill: #5a2a2a; -fx-font-size: 18; -fx-font-weight: bold; -fx-background-radius: 35; -fx-cursor: hand;"/>
    </HBox>

</VBox>