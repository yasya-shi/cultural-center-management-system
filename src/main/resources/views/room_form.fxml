<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="20" style="-fx-padding: 40; -fx-background-color: #fef5f5;"
      xmlns="http://javafx.com/javafx/17"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.culturalcenter.client.controllers.RoomFormController">

    <Text fx:id="titleText" text="Добавление зала" style="-fx-font-size: 28; -fx-font-weight: bold; -fx-fill: #8b3a3a; -fx-font-family: 'Georgia';"/>

    <GridPane hgap="15" vgap="15" alignment="CENTER">
        <Label text="Название зала:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
        <TextField fx:id="nameField" promptText="Название зала" GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="350" prefHeight="45"
                   style="-fx-font-size: 14; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>

        <Label text="Вместимость:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
        <TextField fx:id="capacityField" promptText="Количество мест" GridPane.rowIndex="1" GridPane.columnIndex="1" prefHeight="45"
                   style="-fx-font-size: 14; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>

        <Label text="Оборудование:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
        <TextField fx:id="equipmentField" promptText="Проектор, звук, Wi-Fi..." GridPane.rowIndex="2" GridPane.columnIndex="1" prefHeight="45"
                   style="-fx-font-size: 14; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>

        <Label text="Цена за час:" textFill="#8b3a3a" style="-fx-font-size: 16; -fx-font-weight: bold;" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
        <TextField fx:id="priceField" promptText="100.00" GridPane.rowIndex="3" GridPane.columnIndex="1" prefHeight="45"
                   style="-fx-font-size: 14; -fx-border-radius: 10; -fx-border-color: #d4a0a0; -fx-background-radius: 10; -fx-padding: 0 15;"/>
    </GridPane>

    <HBox spacing="20" alignment="CENTER">
        <Button text="СОХРАНИТЬ" onAction="#onSave" prefWidth="180" prefHeight="50"
                style="-fx-background-color: #a05252; -fx-text-fill: white; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;"/>
        <Button text="ОТМЕНА" onAction="#onCancel" prefWidth="180" prefHeight="50"
                style="-fx-background-color: #d4a0a0; -fx-text-fill: #5a2a2a; -fx-font-size: 15; -fx-font-weight: bold; -fx-background-radius: 25; -fx-cursor: hand;"/>
    </HBox>

</VBox>